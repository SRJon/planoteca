# `engines` do package.json vira ERRO de instalação em vez de aviso. Sem isto,
# quem estiver em Node 20 instala limpo e só descobre o problema quando
# `npm run lint` estoura na resolução de `glob` de `node:fs/promises`
# (`scripts/verifica-tokens.mjs`), que só existe a partir do Node 22.
engine-strict=true
