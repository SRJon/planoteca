{
  "name": "planoteca-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "start": "npm run dev",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.playwright.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.playwright.json",
    "lint": "eslint . --max-warnings 0 && npm run tokens:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "api:sync": "node scripts/api-sync.mjs",
    "api:check": "node scripts/api-sync.mjs --check",
    "api:diff": "node scripts/api-sync.mjs --diff",
    "tokens:check": "node scripts/verifica-tokens.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "class-variance-authority": "^0.7.1",
    "firebase": "^12.18.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.84.0",
    "react-router": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^25.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
